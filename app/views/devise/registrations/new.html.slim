.container.mt-5
  .row.justify-content-center
    .col-12
      .card.shadow-sm
        .card-header.bg-primary.text-white.text-center
          h4.mb-0
            i.bi.bi-person-plus.me-2
            | Sign Up
        .card-body
          = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: {class: "registration-form", autocomplete: "off"}) do |f|
            - if resource.errors.any?
              .alert.alert-danger
                h5.alert-heading
                  i.bi.bi-exclamation-triangle.me-2
                  | Please fix the following errors:
                ul.mb-0
                  - resource.errors.full_messages.each do |message|
                    li = message
            
            .mb-3
              .form-floating
                = f.input :name,
                          input_html: { autocomplete: 'off', class: 'form-control', id: 'floatingName' },
                          label: false,
                          wrapper: false,
                          required: true
                label for="floatingName"
                  i.bi.bi-person.me-1
                  | Full Name
            
            .mb-3
              .form-floating
                = f.input :email,
                          input_html: { autocomplete: 'email', class: 'form-control', id: 'floatingInput' },
                          label: false,
                          wrapper: false,
                          required: true
                label for="floatingInput"
                  i.bi.bi-envelope.me-1
                  | Email address
            
            .mb-3
              .form-floating
                = f.input :password,
                          input_html: { autocomplete: 'new-password', class: 'form-control', id: 'floatingPassword' },
                          label: false,
                          wrapper: false,
                          required: true,
                          hint: "Minimum 6 characters"
                label for="floatingPassword"
                  i.bi.bi-lock.me-1
                  | Password
            
            .mb-3
              .form-floating
                = f.input :password_confirmation,
                          input_html: { autocomplete: 'new-password', class: 'form-control', id: 'floatingPasswordConfirm' },
                          label: false,
                          wrapper: false,
                          required: true
                label for="floatingPasswordConfirm"
                  i.bi.bi-lock-fill.me-1
                  | Confirm Password
            
            .d-grid.gap-2.mb-3
              = f.button :submit, "Sign Up", class: "btn btn-primary btn-lg"
            
            .text-center
              = link_to new_session_path(resource_name), class: "text-decoration-none" do
                i.bi.bi-arrow-left.me-1
                | Already have an account? Sign in